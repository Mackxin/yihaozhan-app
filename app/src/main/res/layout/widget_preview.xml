<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件的**预览**布局（Android 12+ 的 previewLayout）。

  只为了让「长按桌面 → 小组件 → 壹号栈」那个列表里能看清它长什么样 ——
  没有这个，列表里只有一块白板和 app 图标。真正的渲染永远是 widget_st.xml，
  这份里写死的「少数派 / Figma / Excalidraw」纯粹是示例，不会被数据覆盖。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="壹号栈 · 今日三站"
            android:textColor="#F2FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#8FA3B0C4"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 预览用布局：只为了让「添加小组件」列表里能看清长什么样，实际渲染走 widget_st.xml -->
    <LinearLayout
        android:id="@+id/w_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_icon1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_icon"
            android:gravity="center"
            android:textSize="11sp"
            android:maxLines="1"
            android:textColor="#FF9CB6FF"
            android:text="少" />

        <TextView
            android:id="@+id/w_name1"
            android:text="少数派"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F2FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_cat1"
            android:text="效率"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#7AA3B0C4"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_icon2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_icon"
            android:gravity="center"
            android:textSize="11sp"
            android:maxLines="1"
            android:textColor="#FFC7A8FF"
            android:text="Fi" />

        <TextView
            android:id="@+id/w_name2"
            android:text="Figma"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F2FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_cat2"
            android:text="设计天才"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#7AA3B0C4"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_icon3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_icon"
            android:gravity="center"
            android:textSize="11sp"
            android:maxLines="1"
            android:textColor="#FF7FE8DA"
            android:text="E" />

        <TextView
            android:id="@+id/w_name3"
            android:text="Excalidraw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F2FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_cat3"
            android:text="在线工具"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#7AA3B0C4"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_foot"
            android:text="待整理 1  ·  稍后读 3  ·  收藏 12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:textColor="#8FA3B0C4"
        android:textSize="10sp" />
</LinearLayout>
