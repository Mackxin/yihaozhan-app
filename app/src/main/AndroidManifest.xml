<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 自更新要拉起系统安装器；Android 8+ 还得用户手动允许一次「安装未知应用」 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 本地音乐：切出去之后还要接着放，靠前台服务顶住进程（带一条常驻控制条） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 扫本机音乐：Android 13 起音频是细分权限（READ_MEDIA_AUDIO），旧系统才用 READ_EXTERNAL_STORAGE。
         不给也能用 —— 只是「扫本机」搜不到东西，还能靠文件选择器一首首加 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.YiHaoZhan">

        <!-- singleTask：在别的 App 里点「分享 → 壹号栈」时，要回到已经在后台的这一份，
             而不是再起一个实例叠上去（那样收下东西的是新的一份，旧的那份还在后面待着） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.YiHaoZhan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 「分享到」能选到壹号栈：只收纯文字（含网址），图片视频一概不收 ——
                 收了也没地方存，反而会让分享面板多出一个点了没反应的项 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 长按桌面图标的三个快捷方式（res/xml/shortcuts.xml） -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 本地音乐的前台服务：只为了「切出去还在放 + 通知栏能控制」。
             exported=false —— 只接自己和 App 内部的命令 -->
        <service
            android:name=".MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 桌面小组件：今日三站 + 待读数。exported=false —— 只接系统自己的更新广播 -->
        <receiver
            android:name=".Widget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- 下载好的安装包要通过 content:// 交给系统安装器，Android 7 起不许直接给 file:// -->        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
